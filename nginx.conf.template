events {}

http {
    server {
        listen 80;
        server_name capibara.senarecom.com;

        location / {
            proxy_pass http://capibara.192.168.26.240.nip.io:81;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen 80;
        server_name wara.senarecom.com;

        location / {
            proxy_pass http://wara.192.168.26.240.nip.io:82;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
